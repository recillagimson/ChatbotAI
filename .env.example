# ===========================
# App
# ===========================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ChatPilot

# ===========================
# Supabase (database + auth)
# Get these at https://app.supabase.com  > Your Project > Settings > API
# ===========================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_ANON_OR_PUBLISHABLE_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_OR_SECRET_KEY_HERE   # SECRET - server-only, never expose

# ===========================
# Anthropic Claude (AI replies)
# Get at https://console.anthropic.com  > API Keys
# ===========================
ANTHROPIC_API_KEY=PASTE_YOUR_ANTHROPIC_KEY_HERE
ANTHROPIC_MODEL=claude-sonnet-4-6

# ===========================
# Stripe (billing)
# Get at https://dashboard.stripe.com  > Developers > API Keys
# Webhook secret: Developers > Webhooks > add endpoint
# Price ID: Products > create $349/mo recurring product > copy price_xxx
# ===========================
STRIPE_SECRET_KEY=PASTE_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=PASTE_YOUR_STRIPE_WEBHOOK_SECRET_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=PASTE_YOUR_STRIPE_PUBLISHABLE_KEY_HERE
STRIPE_PRICE_ID=PASTE_YOUR_STRIPE_PRICE_ID_HERE

# ===========================
# ManyChat (Instagram/Messenger integration)
# Get at https://manychat.com  > Settings > API
# Shared webhook secret you invent - paste the same string in ManyChat
# External Request settings
# ===========================
MANYCHAT_API_KEY=
MANYCHAT_WEBHOOK_SECRET=invent-a-long-random-string-here

# ===========================
# Upstash Redis (rate limiting, dedup, monthly cap) - OPTIONAL but recommended
# Sign up free at https://console.upstash.com  > Create Database (Global, REST enabled)
# Without these set, all spam-control gates fail OPEN (everything goes to AI).
# ===========================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tuning knobs (all optional, sane defaults shown):
#   RATE_LIMIT_REQUESTS: max inbound DMs per subscriber per window (default 10)
#   RATE_LIMIT_WINDOW:   sliding window duration "10 s" / "1 m" / "1 h" (default "60 s")
#   MONTHLY_REPLY_CAP:   max AI replies per chatbot per calendar month (default 10000)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60 s
MONTHLY_REPLY_CAP=10000

# ===========================
# Cron (auto follow-up job)
# Protects the scheduled /api/cron/followups route. Invent a long random
# string and set the SAME value in Vercel env. Vercel Cron automatically sends
# it as "Authorization: Bearer <CRON_SECRET>". If unset, the route returns 401.
# ===========================
CRON_SECRET=invent-a-long-random-string-here
