# ===========================
# App
# ===========================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Speedsettr

# ===========================
# Supabase (database + auth)
# Get these at https://app.supabase.com  > Your Project > Settings > API
# ===========================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_ANON_OR_PUBLISHABLE_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_OR_SECRET_KEY_HERE   # SECRET - server-only, never expose

# ===========================
# Anthropic Claude (AI replies)
# Get at https://console.anthropic.com  > API Keys
# ===========================
ANTHROPIC_API_KEY=PASTE_YOUR_ANTHROPIC_KEY_HERE
ANTHROPIC_MODEL=claude-sonnet-4-6

# ===========================
# Stripe (billing)
# Get keys at https://dashboard.stripe.com > Developers > API Keys
# Webhook secret: Developers > Webhooks > add endpoint
# Prices: Products > "SpeedSettr Professional" > add two recurring prices:
#   • $997.00 / month  -> STRIPE_PRICE_ID
#   • $10,764.00 / year -> STRIPE_PRICE_ID_ANNUAL   (= $897/mo, 10% off)
# Copy each price_xxx id. Use TEST-mode keys+prices for testing, LIVE for real.
# ===========================
STRIPE_SECRET_KEY=PASTE_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=PASTE_YOUR_STRIPE_WEBHOOK_SECRET_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=PASTE_YOUR_STRIPE_PUBLISHABLE_KEY_HERE
STRIPE_PRICE_ID=PASTE_YOUR_MONTHLY_PRICE_ID_HERE
STRIPE_PRICE_ID_ANNUAL=PASTE_YOUR_ANNUAL_PRICE_ID_HERE

# ===========================
# ManyChat (Instagram/Messenger integration)
# Per-chatbot credentials are now managed IN-APP (Chatbots > [your bot]): each
# chatbot stores its own ManyChat API key (encrypted) and its own webhook secret.
# The two vars below are an OPTIONAL GLOBAL FALLBACK, used only by chatbots that
# have no key/secret saved yet (e.g. the original single bot). New customers do
# not need them. API key: https://manychat.com > Settings > API.
# ===========================
MANYCHAT_API_KEY=
MANYCHAT_WEBHOOK_SECRET=invent-a-long-random-string-here

# ===========================
# Credential encryption (encrypts per-chatbot ManyChat API keys at rest)
# REQUIRED once any customer saves their ManyChat API key in-app. 32-byte master
# key as 64 hex chars. Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store it in Vercel env AND a password manager. Losing it makes saved API keys
# unrecoverable (customers must re-enter). Do NOT rotate without a re-encrypt migration.
# ===========================
CREDENTIALS_ENC_KEY=

# ===========================
# Upstash Redis (rate limiting, dedup, monthly cap) - OPTIONAL but recommended
# Sign up free at https://console.upstash.com  > Create Database (Global, REST enabled)
# Without these set, all spam-control gates fail OPEN (everything goes to AI).
# ===========================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tuning knobs (all optional, sane defaults shown):
#   RATE_LIMIT_REQUESTS: max inbound DMs per subscriber per window (default 10)
#   RATE_LIMIT_WINDOW:   sliding window duration "10 s" / "1 m" / "1 h" (default "60 s")
#   MONTHLY_REPLY_CAP:   max AI replies per chatbot per calendar month (default 10000)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60 s
MONTHLY_REPLY_CAP=10000

# Reply debounce: FALLBACK quiet period (ms) before the bot answers, so a rapid
# burst of messages gets ONE consolidated reply (the timer effectively resets
# while the lead keeps typing). 0 = answer immediately but keep single-flight
# consolidation (never double-reply). Needs the reply_claimed_for migration.
# NOTE: each chatbot now has its OWN window — chatbots.reply_debounce_seconds
# (default 60s, editable in the dashboard), which OVERRIDES this env. This value
# is used only when that column is missing (pre-migration). A 60s+ wait needs
# Vercel Pro (maxDuration 300); on Hobby the function is killed at 60s.
REPLY_DEBOUNCE_MS=5000

# ===========================
# Bubble pacing (human "trickle" between reply messages) — all optional
# The first reply bubble lands fast (~REPLY_THINKING_MS after the DM); each FOLLOW-ON
# bubble then trickles in after a delay that scales with THAT bubble's length — a
# short message waits ~10s, a long one up to ~30s (like typing a longer text longer).
#   BUBBLE_PACING_ENABLED: set "false" to disable — all bubbles send at once (default on)
#   REPLY_THINKING_MS:     min ms the FIRST bubble lands after the DM (default 5000; 0 = off)
#   BUBBLE_GAP_MIN_MS / BUBBLE_GAP_MAX_MS: floor/ceiling for the length-scaled gap (default 10000 / 30000)
#   BUBBLE_GAP_PER_CHAR_MS: ms of "typing" per character (default 150 → ~30s at ~200 chars, ~10s at ≤67)
#   BUBBLE_PACING_BUDGET_MS: total sleep ceiling — a gap is only slept if it FINISHES
#     at/under this, so pacing never exceeds the webhook's maxDuration. Default 280000
#     (sized for Vercel Pro maxDuration=300). On the 60s Hobby budget set this to ~50000.
#   PACING_DEADLINE_MS:    absolute "stop sleeping" age (default 290000; keep < maxDuration)
#   MAX_BUBBLES:           max messages a reply is split into (default 6; overflow merges into the last)
# NOTE: honoring the full 10–30s across many bubbles needs the webhook maxDuration
# raised to 300 (Vercel Pro) — it's a static literal in route.ts, not env-driven.
BUBBLE_PACING_ENABLED=true
REPLY_THINKING_MS=5000
BUBBLE_GAP_MIN_MS=10000
BUBBLE_GAP_MAX_MS=30000
BUBBLE_GAP_PER_CHAR_MS=150
BUBBLE_PACING_BUDGET_MS=280000
PACING_DEADLINE_MS=290000
MAX_BUBBLES=6

# ===========================
# Cron (auto follow-up job)
# Protects the scheduled /api/cron/followups route. Invent a long random
# string and set the SAME value in Vercel env. Vercel Cron automatically sends
# it as "Authorization: Bearer <CRON_SECRET>". If unset, the route returns 401.
# ===========================
CRON_SECRET=invent-a-long-random-string-here

# --- KB adaptive retrieval (OpenAI embeddings) — optional; absent = full-context only ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Change-request AI (the /requests chat + admin auto-draft) runs on OpenAI and
# reuses OPENAI_API_KEY above. Default model gpt-4.1-mini is the efficient floor
# that reliably calls the propose_changes tool; override here if desired.
OPENAI_CHANGE_MODEL=gpt-4.1-mini

# ===========================
# Conversation auto-tagging + subscribed auto-stop — optional
# Each AI turn runs a tiny background classifier (OpenAI, reuses OPENAI_API_KEY;
# model = CONFIRM_DETECT_MODEL, default gpt-4.1-mini) that tags the thread as
# lead / wants_call / needs_human / subscribed. A "subscribed" result marks the
# contact confirmed, which stops the follow-up drip AND silences the bot. Set to
# "false" to disable all classifier calls (tags then only change manually).
# ===========================
AUTO_TAG_ENABLED=true
CONFIRM_DETECT_MODEL=gpt-4.1-mini

# ===========================
# Reset-conversation keyword — optional, testing tool
# A universal magic word: when a contact texts EXACTLY this (whole-message match),
# their conversation is wiped back to a brand-new state (transcript deleted + all
# funnel flags reset) so the full flow (welcome VM, keywords, follow-ups) can be
# re-tested. Set an obscure value while testing; LEAVE BLANK in production (blank =
# feature off). Universal across all chatbots; resets only the sender's own thread.
# ===========================
RESET_KEYWORD=
