# React is pinned to a Next 15.0.7 release-candidate (19.0.0-rc-…). Some deps
# (e.g. recharts@2.15.4 → react-smooth) declare a React peer range that, per
# semver, excludes prerelease tags — so a clean `npm install` on Vercel fails
# with ERESOLVE. legacy-peer-deps makes CI use the same resolution as our
# committed lockfile/local install. Remove once React is on a stable 19.x.
legacy-peer-deps=true
